# ─── CPanel Production Environment ───────────────────────────────────────────
# IMPORTANT: Fill in YOUR values before uploading to CPanel

PORT=3000

# Database — use the MySQL credentials from CPanel MySQL Databases
DATABASE_URL=mysql://tamil_user:YOUR_DB_PASSWORD@localhost:3306/tamil_news

# JWT Secrets — generate strong random strings (min 32 chars)
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET_32_CHARS_MIN
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_STRONG_RANDOM_SECRET

# CORS — your actual domain
CORS_ORIGIN=https://yourdomain.com,https://cms.yourdomain.com

# Image encryption — MUST be exactly 32 characters, never change after images are stored
IMAGE_ENCRYPTION_KEY=REPLACE_WITH_EXACTLY_32_CHAR_KEY!!

# Media uploads
MEDIA_UPLOAD_PATH=./uploads

# Site URLs — your actual domains
SITE_URL=https://yourdomain.com
FRONTEND_REVALIDATE_URL=https://yourdomain.com/api/revalidate
REVALIDATE_SECRET=REPLACE_WITH_RANDOM_REVALIDATE_SECRET
